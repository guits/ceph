# Ceph Node Proxy Configuration File
# Copy this file to /etc/ceph/node-proxy.yml and customize as needed

# Reporter Configuration
# Controls how data is reported to the Ceph manager
reporter:
  # Interval (in seconds) between status checks
  check_interval: 5
  
  # Maximum number of retries when pushing data fails
  push_data_max_retries: 30
  
  # Endpoint path for reporting data
  endpoint: '/node-proxy/data'
  
  # URL scheme for reporter (http or https)
  scheme: 'https'

# System Configuration
# Controls hardware monitoring behavior
system:
  # Interval (in seconds) between hardware data refreshes
  refresh_interval: 5

# API Configuration
# Controls the REST API server
api:
  # Port on which the API server listens
  port: 9456
  
  # Host address to bind to (0.0.0.0 = all interfaces)
  host: '0.0.0.0'

# Logging Configuration
# Controls application logging behavior
logging:
  # Logging level (10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR, 50=CRITICAL)
  level: 20
  
  # Log format string (using Python logging format)
  format: '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
